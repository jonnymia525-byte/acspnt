generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  name          String    @default("")
  role          String    @default("buyer")
  balance       Float     @default(0)
  vendorStatus  String    @default("none")
  vendorReason  String    @default("")
  vendorCountry String    @default("")
  contactMethod String    @default("")
  contactDetail String    @default("")
  twoFaEnabled  Boolean   @default(false)
  twoFaSecret   String?
  backupCodes   String?
  muted         Boolean   @default(false)
  mutedUntil    DateTime?
  blocked       Boolean   @default(false)
  registeredAt  DateTime  @default(now())
  registrationIp String?
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Referral system
  referralCode    String?   @unique
  referredById    String?
  referredBy      User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]    @relation("Referrals")
  referralEarnings Float    @default(0)

  // Vendor enhancements
  vendorBio       String    @default("")
  vendorLogo      String?
  vendorRating    Float     @default(0)
  vendorSalesCount Int      @default(0)
  vendorResponseTime Float?
  vendorFulfillmentRate Float @default(100)
  emailVerified Boolean  @default(false)
  googleId      String?  @unique
  country       String?

  ownedListings     Listing[]
  ownedProducts     Product[]
  purchases         Purchase[]
  deposits          Deposit[]
  disputes          Dispute[]
  reviewsReceived   Review[]      @relation("VendorReviews")
  reviewsGiven      Review[]      @relation("ReviewsGiven")
  withdrawals       Withdrawal[]
  directReports     DirectReport[]
  ticketsReceived   SupportTicket[]
  ticketsGiven      SupportTicket[] @relation("TicketsGiven")
  transactions      Transaction[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  vendorRequests    VendorRequest[]
  emailLogs         EmailLog[]
  usedCoupons       UsedCoupon[]
  wishlists         Wishlist[]
  restockNotifs     RestockNotification[]
  apiKeys           ApiKey[]
  invoices          Invoice[]
  bulkCartItems     BulkCart[]
  vendorMessages    VendorMessage[]  @relation("VendorMsgReceiver")
  vendorMessagesSent VendorMessage[] @relation("VendorMsgSender")
  chatSessions       ChatSession[] @relation("ChatUser")
  assignedSessions   ChatSession[] @relation("ChatAssignee")
  chatSentMessages   ChatMessage[] @relation("ChatSender")
  passwordReset      PasswordReset?

  @@index([role])
  @@index([vendorStatus])
  @@index([referralCode])
}

model Listing {
  id              String    @id @default(cuid())
  title           String
  platform        String
  category        String    @default("")
  description     String    @default("")
  deliveryFormat  String    @default("email:pass")
  countryRegister String    @default("")
  originalMail    Boolean   @default(false)
  country         String    @default("")
  proxy           String    @default("")
  visible         Boolean   @default(true)
  bestSeller      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  vendorId        String?
  vendor          User?     @relation(fields: [vendorId], references: [id])
  products        Product[]
  reviews         Review[]

  @@index([platform])
  @@index([category])
  @@index([vendorId])
}

model Product {
  id              String    @id @default(cuid())
  title           String
  sku             String?   @unique
  description     String    @default("")
  platform        String
  category        String    @default("")
  vendorPrice     Float     @default(0)
  storePrice      Float     @default(0)
  stock           Int       @default(0)
  status          String    @default("pending")
  visible         Boolean   @default(true)
  accountsData    String    @default("")
  deliveryFormat  String    @default("email:pass")
  countryRegister String    @default("")
  originalMail    Boolean   @default(false)
  country         String    @default("")
  proxy           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Enhanced fields
  lowStockThreshold Int     @default(5)
  views             Int     @default(0)
  totalSales        Int     @default(0)
  avgResponseTime   Float?
  deletedAt         DateTime?

  // Merge system: tracks which "master" product this was cloned from
  parentProductId  String?
  parentProduct   Product?  @relation("MergeChildren", fields: [parentProductId], references: [id])
  mergedChildren  Product[] @relation("MergeChildren")
  isMerged        Boolean  @default(false)
  mergeGroup      String?  // groups merged products together

  listingId       String?
  listing         Listing?  @relation(fields: [listingId], references: [id])
  vendorId        String
  vendor          User      @relation(fields: [vendorId], references: [id])
  purchases       Purchase[]
  reviews         Review[]
  wishlists       Wishlist[]
  restockNotifs   RestockNotification[]
  bulkCartItems   BulkCart[]

  @@index([vendorId])
  @@index([platform])
  @@index([status])
  @@index([listingId])
  @@index([visible])
  @@index([stock])
}

model Purchase {
  id           String    @id @default(cuid())
  quantity     Int       @default(1)
  subtotal     Float
  discount     Float     @default(0)
  couponCode   String?
  total        Float
  accounts     String    @default("")
  status       String    @default("completed")
  createdAt    DateTime  @default(now())

  // Commission & earnings
  commissionAmount Float  @default(0)
  vendorEarning    Float  @default(0)
  platformFee      Float  @default(0)

  buyerId      String
  buyer        User      @relation(fields: [buyerId], references: [id])
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  disputes     Dispute[]

  @@index([buyerId])
  @@index([productId])
}

model Deposit {
  id            String   @id @default(cuid())
  amount        Float
  method        String
  status        String   @default("pending")
  txId          String?
  network       String?
  exactAmount   Float?
  txHash        String?
  walletAddress String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([txHash])
}

model Dispute {
  id          String   @id @default(cuid())
  reason      String
  status      String   @default("open")
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  evidenceUrls String? // JSON array of evidence file URLs
  slaDeadline DateTime?
  adminNote   String?
  refundAmount Float?   @default(0)
  vendorCharge Float?   @default(0)

  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  purchaseId  String?
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  vendorId    String?
  productId   String?
  orderId     String?

  @@index([buyerId])
  @@index([status])
}

model Withdrawal {
  id           String   @id @default(cuid())
  amount       Float
  netAmount    Float
  fee          Float
  method       String
  wallet       String
  status       String   @default("pending")
  rejectReason String?
  createdAt    DateTime @default(now())
  processedAt  DateTime?

  userId       String
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  buyerId   String
  buyer     User     @relation("ReviewsGiven", fields: [buyerId], references: [id])
  vendorId  String?
  vendor    User?    @relation("VendorReviews", fields: [vendorId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])

  @@index([buyerId])
  @@index([vendorId])
  @@index([productId])
}

model DirectReport {
  id         String   @id @default(cuid())
  issueType  String
  message    String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  buyerId    String
  buyer      User     @relation(fields: [buyerId], references: [id])
  purchaseId String?
  vendorId   String?
  productId  String?

  @@index([buyerId])
  @@index([status])
}

model SupportTicket {
  id            String   @id @default(cuid())
  subject       String
  category      String
  priority      String   @default("normal")
  message       String
  status        String   @default("open")
  reply         String?
  attachmentUrl String?
  attachmentName String?
  createdAt     DateTime @default(now())
  autoEscalated Boolean  @default(false)

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  repliedById   String?
  repliedBy     User?    @relation("TicketsGiven", fields: [repliedById], references: [id])

  @@index([userId])
  @@index([status])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String
  value       Float
  minOrder    Float     @default(0)
  maxUses     Int       @default(-1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  vendorId    String?   // vendor-specific coupons

  usedCoupons UsedCoupon[]

  @@index([active])
}

model UsedCoupon {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  description String   @default("")
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info")
  section   String   @default("general")
  link      String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([userId, section])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  description String   @default("")
  ip          String?
  country     String?
  city        String?
  userAgent   String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([ip])
}

model VendorRequest {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  productDetails String
  bulk           Boolean  @default(false)
  status         String   @default("pending")
  adminComments  String?
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?

  userId         String
  user           User     @relation(fields: [userId], references: [id])

  @@index([status])
}

model Setting {
  key   String @id
  value String
}

model EmailLog {
  id          String   @id @default(cuid())
  toEmail     String
  templateKey String
  subject     String
  body        String
  status      String   @default("sent")
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@index([toEmail])
  @@index([templateKey])
}

// ==================== NEW MODELS ====================

model Wishlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
}

model RestockNotification {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending, notified
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([status])
}

model Referral {
  id           String   @id @default(cuid())
  referralCode String
  referredById String
  referredById_2 String  // the user who was referred
  earnings     Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([referralCode])
  @@index([referredById])
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  active    Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([key])
}

model Invoice {
  id         String   @id @default(cuid())
  invoiceNo  String   @unique
  amount     Float
  commission Float
  netAmount  Float
  period     String   // e.g. "2024-01" or "2024-W03"
  status     String   @default("pending") // pending, paid
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([invoiceNo])
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("general")
  createdAt DateTime @default(now())

  @@index([category])
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  imageUrl   String
  linkUrl    String?
  position   String   @default("top") // top, bottom, sidebar
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  startsAt   DateTime?
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([active])
  @@index([position])
}

model ScheduledAnnouncement {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, urgent, coupon, maintenance
  target    String   @default("all") // all, buyers, vendors
  active    Boolean  @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  deletedAt DateTime?
  closeable        Boolean @default(true)
  hiddenForUserIds String?
  createdAt DateTime @default(now())

  @@index([active])
}

model BulkCart {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
}

model VendorMessage {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  senderId   String
  sender     User     @relation("VendorMsgSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("VendorMsgReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  event     String   // deposit, purchase, withdrawal, etc.
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([event])
}

model ChatSession {
  id          String        @id @default(cuid())
  subject     String
  category    String        @default("general")
  status      String        @default("open")  // open, assigned, resolved, closed
  priority    String        @default("normal")
  userId      String
  user        User          @relation("ChatUser", fields: [userId], references: [id])
  assignedTo  String?
  assignee    User?         @relation("ChatAssignee", fields: [assignedTo], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  relatedType String?
  relatedId   String?
  typingAt    DateTime?
  slaDeadline DateTime?
  rating      Int?
  ratingComment String?
  messages    ChatMessage[]

  @@index([userId])
  @@index([assignedTo])
  @@index([status])
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User        @relation("ChatSender", fields: [senderId], references: [id])
  message     String
  attachment  String?
  isAdmin     Boolean     @default(false)
  read        Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([sessionId])
  @@index([senderId])
}

